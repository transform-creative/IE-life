# Copy to .env.local and fill in. .env.local is gitignored.

# Public (Vite-exposed) — bundled into the client.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Unused template leftovers ------------------------------------------
# The stripe-checkout / email-handler / moderate-image edge functions came
# from the react-starter template and are not wired up in IE Life. Leave
# these blank unless one of those functions is actually adopted.
VITE_STRIPE_PUBLISHABLE_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
GOOGLE_VISION_API_KEY=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
